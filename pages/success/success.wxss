.page-shell {
  min-height: 100vh;
  overflow-x: hidden;
  padding: 70rpx 32rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 0, rgba(248, 199, 124, 0.42), rgba(255, 247, 232, 0) 380rpx),
    #fff7e8;
  text-align: center;
}

.success-mark {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 42rpx;
  background: #4f7d5a;
  box-shadow: 0 18rpx 42rpx rgba(79, 125, 90, 0.22);
}

.check-line {
  position: absolute;
  height: 8rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  transform-origin: left center;
}

.check-line.short {
  top: 70rpx;
  left: 34rpx;
  width: 28rpx;
  transform: rotate(42deg);
}

.check-line.long {
  top: 80rpx;
  left: 56rpx;
  width: 52rpx;
  transform: rotate(-48deg);
}

.title {
  display: block;
  color: #4b3527;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
}

.subtitle {
  display: block;
  max-width: 560rpx;
  margin: 14rpx auto 34rpx;
  color: #9b6d48;
  font-size: 26rpx;
  line-height: 1.55;
}

.receipt {
  position: relative;
  overflow: hidden;
  margin-bottom: 34rpx;
  padding: 34rpx 30rpx 28rpx;
  border: 2rpx solid #efd9bd;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 42rpx rgba(111, 61, 46, 0.1);
  text-align: left;
  word-break: break-all;
}

.receipt-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

.receipt-edge {
  position: absolute;
  top: -8rpx;
  right: 34rpx;
  left: 34rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: repeating-linear-gradient(
    90deg,
    #efd9bd 0,
    #efd9bd 18rpx,
    transparent 18rpx,
    transparent 34rpx
  );
}

.receipt-edge,
.receipt-row,
.receipt-total {
  position: relative;
  z-index: 1;
}

.receipt-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed rgba(239, 217, 189, 0.9);
}

.receipt-row.vertical {
  flex-direction: column;
  gap: 8rpx;
}

.label {
  flex: 0 0 auto;
  color: #9b6d48;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.45;
}

.value {
  color: #4b3527;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
  text-align: right;
  word-break: break-all;
}

.vertical .value {
  text-align: left;
}

.receipt-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  color: #d85f45;
  font-size: 30rpx;
  font-weight: 900;
}

.primary-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
}

.primary-button {
  background: #6f3d2e;
  color: #fffdf8;
  box-shadow: 0 16rpx 38rpx rgba(111, 61, 46, 0.18);
}

.text-button {
  margin-top: 12rpx;
  color: #6f3d2e;
}

.primary-button:active,
.text-button:active {
  opacity: 0.86;
}
